---
import { directions } from '../lib/directions';
import Icon from './Icon.astro';
---
<aside class="design-dock" aria-label="Compare visual directions">
  <label for="design-select">Design</label>
  <select id="design-select" aria-label="Preview design">{directions.map((direction) => <option value={direction.id}>{direction.name}</option>)}</select>
  <a href="/directions/">Compare <Icon name="external" size={13} /></a>
</aside>
<script>
  const selector = document.querySelector<HTMLSelectElement>('#design-select')!;
  selector.value = document.documentElement.dataset.look || '';
  selector.addEventListener('change', () => {
    const look = selector.value;
    document.documentElement.dataset.look = look;
    document.documentElement.style.colorScheme = 'light';
    try { localStorage.setItem('iondy-look', look); } catch {}
    const url = new URL(window.location.href);
    url.searchParams.set('look', look);
    history.replaceState(null, '', url);
  });
</script>
