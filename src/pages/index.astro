---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import PaperRow from '../components/PaperRow.astro';
import Icon from '../components/Icon.astro';
import { getPosts, papers } from '../lib/content';
const posts = await getPosts();
---
<Base>
  <section class="home-hero">
    <div class="hero-copy">
      <h1>Lukas Hauzenberger</h1>
      <p class="hero-description">Machine learning research, projects, and notes on what I’m learning.</p>
    </div>
  </section>
  <div class="home-grid">
    <section id="writing" class="writing-section">
      <div class="section-heading"><h2>Recent writing</h2><a class="micro-link" href="/writing/">All writing <Icon name="arrow" size={16} /></a></div>
      <div class="post-list">{posts.slice(0, 4).map((post) => <PostRow post={post} />)}</div>
      <a class="archive-link" href="/writing/">More from the notebook <Icon name="arrow" size={18} /></a>
    </section>
    <section id="research" class="research-section">
      <div class="section-heading"><h2>Research</h2><a class="micro-link" href="/research/">All papers <Icon name="arrow" size={16} /></a></div>
      <div class="paper-list">{papers.slice(0, 4).map((paper) => <PaperRow paper={paper} />)}</div>
    </section>
  </div>
</Base>
