---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../lib/content';
---
<Base title="Projects — iondy" active="projects">
  <header class="page-intro"><h1>Projects</h1><p>Implementations and experiments, with code you can run and build on.</p></header>
  <div class="project-index">{projects.map((project, index) => <article class="project-detail"><span class="project-detail-number">0{index + 1}</span><div class="project-detail-content"><p class="eyebrow">{project.kind}</p><h2>{project.name}</h2><p>{project.description}</p><span class="project-stack">{project.stack}</span><div class="project-detail-links"><a class="text-link" href={project.url} target="_blank" rel="noreferrer">Explore the code <Icon name="external" size={16} /></a><a class="quiet-link" href={`/writing/${project.note}/`}>Read the write-up <Icon name="arrow" size={16} /></a></div></div><span class="project-detail-mark"><Icon name={project.mark} size={54} /></span></article>)}</div>
  <div class="page-outro"><p>More experiments live on GitHub.</p><a class="text-link" href="https://github.com/sirluk" target="_blank" rel="noreferrer">github.com/sirluk <Icon name="external" size={17} /></a></div>
</Base>
