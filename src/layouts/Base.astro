---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist/wght-italic.css';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '../styles/site.css';
import '../styles/quiet.css';
import '../styles/slop.css';
import SlopSlider from '../components/SlopSlider.astro';
import Icon from '../components/Icon.astro';
import { scholarUrl } from '../lib/content';
import { slopLevels } from '../lib/slop';
// html[data-look="quiet"] scopes quiet.css and slop.css on top of the shared rules in site.css.
interface Props { title?: string; description?: string; active?: string; noindex?: boolean; }
const { title = 'Lukas Hauzenberger — iondy', description = 'Projects, research, and things learned along the way. A personal notebook by Lukas Hauzenberger.', active = '', noindex = false } = Astro.props;
const links = [{ label: 'Writing', href: '/writing/' }, { label: 'Research', href: '/research/' }, { label: 'Projects', href: '/projects/' }, { label: 'About', href: '/about/' }];
---
<!doctype html>
<html lang="en" data-look="quiet">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="iondy — Writing" href="/rss.xml" />
    <script define:vars={{ slopMax: slopLevels.length - 1 }}>
      (() => {
        const param = new URLSearchParams(location.search).get('slop');
        let stored = '';
        try { stored = localStorage.getItem('iondy-slop') || ''; } catch {}
        // data-slop lists every level up to the chosen one ("1 2 3"), so CSS can match "level 2 or more" with [data-slop~='2'].
        const slop = Math.min(slopMax, Math.max(0, Number.parseInt(param ?? stored, 10) || 0));
        document.documentElement.dataset.slop = Array.from({ length: slop }, (_, i) => i + 1).join(' ');
        document.documentElement.style.setProperty('--slop-level', String(slop));
        if (param !== null) {
          try { localStorage.setItem('iondy-slop', String(slop)); } catch {}
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="iondy home">iondy<span class="wordmark-dot" aria-hidden="true"></span><span class="wordmark-slash" aria-hidden="true">/</span></a>
        <nav class="main-nav" aria-label="Main navigation">
          {links.map((link) => <a href={link.href} aria-current={active === link.label.toLowerCase() ? 'page' : undefined}>{link.label}</a>)}
        </nav>
        <SlopSlider />
        <a class="header-github quiet-link" href="https://github.com/sirluk" target="_blank" rel="noreferrer">GitHub <Icon name="external" size={15} /></a>
      </header>
      <div class="site-main">
        <main id="main" tabindex="-1"><slot /></main>
        <footer class="site-footer">
          <a href="/" class="footer-name">Lukas Hauzenberger</a>
          <div class="footer-links"><a href="https://github.com/sirluk" target="_blank" rel="noreferrer">GitHub ↗</a><a href={scholarUrl} target="_blank" rel="noreferrer">Google Scholar ↗</a><a href="/rss.xml">RSS <Icon name="rss" size={13} /></a></div>
        </footer>
      </div>
    </div>
  </body>
</html>
